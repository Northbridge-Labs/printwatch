# PrintWatch configuration. Copy to .env and adjust.

# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=printwatch
POSTGRES_USER=printwatch
POSTGRES_PASSWORD=printwatch
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# ─── Cache / Celery broker (Valkey) ──────────────────────────────────────────
VALKEY_HOST=cache
VALKEY_PORT=6379
VALKEY_DB=0

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://cache:6379/1
CELERY_RESULT_BACKEND=redis://cache:6379/2

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SIGNING_KEY=change-me-jwt-signing-key
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_DEV_TOKEN_YEARS=10

# ─── Ingest (ZeroMQ) ─────────────────────────────────────────────────────────
ZMQ_BIND_HOST=tcp://*:5558
ZMQ_CONSUMER_CONNECT=tcp://zmq-consumer:5558
INGEST_SERVICE_TOKEN=change-me-ingest-service-token

# ─── Developer API throttle ─────────────────────────────────────────────────
DEV_API_THROTTLE_RATE=60/min

# ─── Superuser bootstrap ─────────────────────────────────────────────────────
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin